# Credentials and signing keys, generated by Terraform and stored in Secrets Manager. The app receives them as ECS
# secrets (injected at task start); nothing is baked into the image or passed as a plain environment value.
#
# Terraform state holds the generated values, so the state bucket must stay private and encrypted (see infra/README.md).
# The OpenAI key is the exception: it is NEVER given to Terraform. A placeholder is created and you replace it with
# put-secret-value, so the real key never appears in state or in CI logs.

resource "random_password" "db_owner" {
  length  = 28
  special = false # safe inside a JDBC URL or a shell without escaping
}

resource "random_password" "db_app" {
  length  = 28
  special = false
}

# Ed25519 key pair for signing audit anchors. The app wants the bare base64 body (PKCS#8 private, X.509 public).
resource "tls_private_key" "anchor" {
  algorithm = "ED25519"
}

locals {
  pem_body = {
    private = replace(replace(replace(tls_private_key.anchor.private_key_pem, "-----BEGIN PRIVATE KEY-----", ""), "-----END PRIVATE KEY-----", ""), "\n", "")
    public  = replace(replace(replace(tls_private_key.anchor.public_key_pem, "-----BEGIN PUBLIC KEY-----", ""), "-----END PUBLIC KEY-----", ""), "\n", "")
  }
}

resource "aws_secretsmanager_secret" "db" {
  #checkov:skip=CKV_AWS_149: Encrypted with the AWS-managed Secrets Manager key; a customer-managed key adds cost and is a production step.
  #checkov:skip=CKV2_AWS_57: Automatic rotation is a production follow-up (needs a rotation function and app support for reloading credentials).
  name                    = "${var.name}/db"
  description             = "Database owner (Flyway) and application login"
  recovery_window_in_days = var.recovery_window_days
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id
  secret_string = jsonencode({
    owner_user   = "reconcile"
    owner_pass   = random_password.db_owner.result
    app_user     = "reconcile_app"
    app_password = random_password.db_app.result
  })
}

resource "aws_secretsmanager_secret" "anchor" {
  #checkov:skip=CKV_AWS_149: Encrypted with the AWS-managed Secrets Manager key; a customer-managed key adds cost and is a production step.
  #checkov:skip=CKV2_AWS_57: Automatic rotation is a production follow-up (needs a rotation function and app support for reloading credentials).
  name                    = "${var.name}/audit-anchor-key"
  description             = "Ed25519 key pair that signs audit anchors"
  recovery_window_in_days = var.recovery_window_days
}

resource "aws_secretsmanager_secret_version" "anchor" {
  secret_id = aws_secretsmanager_secret.anchor.id
  secret_string = jsonencode({
    private_key = local.pem_body.private
    public_key  = local.pem_body.public
  })
}

resource "aws_secretsmanager_secret" "openai" {
  #checkov:skip=CKV_AWS_149: Encrypted with the AWS-managed Secrets Manager key; a customer-managed key adds cost and is a production step.
  #checkov:skip=CKV2_AWS_57: Automatic rotation is a production follow-up (needs a rotation function and app support for reloading credentials).
  name                    = "${var.name}/openai-api-key"
  description             = "OpenAI API key (embeddings, and chat when the openai profile is used). Set it with put-secret-value."
  recovery_window_in_days = var.recovery_window_days
}

resource "aws_secretsmanager_secret_version" "openai" {
  secret_id     = aws_secretsmanager_secret.openai.id
  secret_string = "REPLACE_ME_WITH_put-secret-value"

  lifecycle {
    ignore_changes = [secret_string] # the real key is set out of band and must not be reverted by the next apply
  }
}
