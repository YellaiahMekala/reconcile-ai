{
  "realm": "reconcile",
  "enabled": true,
  "displayName": "reconcile-ai (LOCAL DEMO REALM - synthetic users, throwaway passwords)",
  "sslRequired": "external",
  "accessTokenLifespan": 1800,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "RECON_ANALYST", "description": "Maker: creates breaks, uploads evidence, runs investigations" },
      { "name": "APPROVER_L1", "description": "Checker for variance below the L2 threshold" },
      { "name": "APPROVER_L2", "description": "Checker for material variance" },
      { "name": "SRE_ADMIN", "description": "Audit verification, digests, operations" }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "reconcile-ui",
      "name": "reconcile-ai web console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "reconcile-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "analyst", "enabled": true, "email": "analyst@example.invalid", "emailVerified": true,
      "firstName": "Demo", "lastName": "Analyst",
      "attributes": { "tenant_id": ["TENANT_DEMO"] },
      "realmRoles": ["RECON_ANALYST"],
      "credentials": [{ "type": "password", "value": "demo-only", "temporary": false }]
    },
    {
      "username": "approver-l1", "enabled": true, "email": "approver-l1@example.invalid", "emailVerified": true,
      "firstName": "Demo", "lastName": "ApproverL1",
      "attributes": { "tenant_id": ["TENANT_DEMO"] },
      "realmRoles": ["APPROVER_L1"],
      "credentials": [{ "type": "password", "value": "demo-only", "temporary": false }]
    },
    {
      "username": "approver-l2", "enabled": true, "email": "approver-l2@example.invalid", "emailVerified": true,
      "firstName": "Demo", "lastName": "ApproverL2",
      "attributes": { "tenant_id": ["TENANT_DEMO"] },
      "realmRoles": ["APPROVER_L2"],
      "credentials": [{ "type": "password", "value": "demo-only", "temporary": false }]
    },
    {
      "username": "sre", "enabled": true, "email": "sre@example.invalid", "emailVerified": true,
      "firstName": "Demo", "lastName": "Sre",
      "attributes": { "tenant_id": ["TENANT_DEMO"] },
      "realmRoles": ["SRE_ADMIN"],
      "credentials": [{ "type": "password", "value": "demo-only", "temporary": false }]
    },
    {
      "username": "other-analyst", "enabled": true, "email": "other@example.invalid", "emailVerified": true,
      "firstName": "Other", "lastName": "Tenant",
      "attributes": { "tenant_id": ["TENANT_OTHER"] },
      "realmRoles": ["RECON_ANALYST", "APPROVER_L1"],
      "credentials": [{ "type": "password", "value": "demo-only", "temporary": false }]
    },
    {
      "username": "no-tenant", "enabled": true, "email": "no-tenant@example.invalid", "emailVerified": true,
      "firstName": "No", "lastName": "Tenant",
      "realmRoles": ["RECON_ANALYST"],
      "credentials": [{ "type": "password", "value": "demo-only", "temporary": false }]
    }
  ]
}
